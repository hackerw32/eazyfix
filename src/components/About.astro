---
import Icon from './Icon.astro';

interface Props {
  about: {
    title: Record<string, string>;
    lead: Record<string, string>;
    text: Record<string, string>;
    skills: string[];
  };
  social: { label: string; url: string }[];
  locale: 'el' | 'en';
}

const { about, social, locale } = Astro.props;
const eyebrow = locale === 'en' ? 'About' : 'Σχετικά';
const skillsTitle = locale === 'en' ? 'Technologies' : 'Τεχνολογίες';
---

<section id="about" class="section section--soft">
  <div class="container about">
    <div class="about-copy">
      <span class="eyebrow">{eyebrow}</span>
      <h2 class="h2">{about.title[locale]}</h2>
      <p class="about-lead">{about.lead[locale]}</p>
      <p class="about-text">{about.text[locale]}</p>

      {social.length > 0 && (
        <div class="socials">
          {social.map((item) => (
            <a href={item.url} target="_blank" rel="noopener" class="social">
              <Icon name="external-link" size={16} />
              {item.label}
            </a>
          ))}
        </div>
      )}
    </div>

    <div class="about-side">
      <div class="skills-card">
        <h3>{skillsTitle}</h3>
        <div class="skills">
          {about.skills.map((skill) => (
            <span class="skill">{skill}</span>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 56px;
    align-items: start;
  }

  .about-lead {
    margin-top: 18px;
    font-size: 1.15rem;
    font-family: var(--font-head);
    font-weight: 600;
  }

  .about-text {
    margin-top: 16px;
    color: var(--muted);
    font-size: 1.02rem;
    max-width: 62ch;
    white-space: pre-line;
  }

  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }

  .social {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: #fff;
    font-weight: 600;
    font-size: 0.9rem;
    transition: border-color 0.18s ease, color 0.18s ease;
  }

  .social:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .skills-card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 30px;
    box-shadow: var(--shadow-md);
  }

  .skills-card h3 {
    font-size: 1.05rem;
    margin-bottom: 18px;
  }

  .skills {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
  }

  .skill {
    font-size: 0.82rem;
    font-weight: 600;
    padding: 7px 14px;
    border-radius: 999px;
    background: var(--bg-soft);
    border: 1px solid var(--line);
    color: var(--ink-soft);
  }

  @media (max-width: 860px) {
    .about {
      grid-template-columns: 1fr;
      gap: 34px;
    }
  }
</style>
