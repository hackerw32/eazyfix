---
const brand = 'Dentia';
const trust = [
  { title: 'Ανώδυνη φροντίδα', text: 'Ήπιες τεχνικές και σύγχρονη αναισθησία.' },
  { title: 'Σύγχρονος εξοπλισμός', text: 'Ψηφιακή απεικόνιση και ακριβείς διαγνώσεις.' },
  { title: 'Αποστείρωση', text: 'Αυστηρά πρωτόκολλα υγιεινής σε κάθε περιστατικό.' },
  { title: 'Online ραντεβού', text: 'Κλείσε ραντεβού σε λίγα δευτερόλεπτα, 24/7.' },
];
const services = [
  { name: 'Προληπτικός καθαρισμός', text: 'Απομάκρυνση πλάκας & πέτρας, έλεγχος.' },
  { name: 'Σφραγίσματα', text: 'Αισθητικά σφραγίσματα, χωρίς πόνο.' },
  { name: 'Λεύκανση δοντιών', text: 'Ασφαλής λεύκανση με άμεσο αποτέλεσμα.' },
  { name: 'Εμφυτεύματα', text: 'Λύση για χαμένα δόντια, φυσική αίσθηση.' },
  { name: 'Ορθοδοντική', text: 'Σιδεράκια και διαφανείς νάρθηκες.' },
  { name: 'Παιδοδοντιατρική', text: 'Φιλική φροντίδα για τα παιδιά.' },
  { name: 'Ενδοδοντία', text: 'Απονεύρωση με μικροσκόπιο.' },
  { name: 'Χειρουργική', text: 'Εξαγωγές και επεμβάσεις με ασφάλεια.' },
];
const team = [
  { name: 'Δρ. Μαρία Κωνσταντίνου', role: 'Οδοντίατρος · Ιδρύτρια', field: 'Κοσμητική & Προσθετική' },
  { name: 'Δρ. Αλέξανδρος Ρήγας', role: 'Οδοντίατρος', field: 'Εμφυτευματολογία' },
  { name: 'Δρ. Ειρήνη Παπά', role: 'Ορθοδοντικός', field: 'Ορθοδοντική & Παιδοδοντιατρική' },
];
const prices = [
  { name: 'Καθαρισμός & έλεγχος', price: '50€' },
  { name: 'Αισθητικό σφράγισμα', price: '40–70€' },
  { name: 'Λεύκανση', price: '180€' },
  { name: 'Εμφύτευμα', price: 'από 700€' },
  { name: 'Ορθοδοντική', price: 'από 1.500€' },
];
const reviews = [
  { name: 'Παναγιώτης Χ.', text: 'Πρώτη φορά χωρίς άγχος σε οδοντίατρο. Εξαιρετικός επαγγελματισμός.' },
  { name: 'Ναταλία Τ.', text: 'Καθαρός χώρος, ευγενικό προσωπικό και άριστο αποτέλεσμα στη λεύκανση.' },
  { name: 'Γιώργος Δ.', text: 'Πήρα τα παιδιά μου και ήταν χαρούμενα. Τους συνιστώ ανεπιφύλακτα.' },
];
const faq = [
  { q: 'Πονάει η θεραπεία;', a: 'Χρησιμοποιούμε σύγχρονη αναισθησία και ήπιες τεχνικές. Η άνεσή σας είναι προτεραιότητα.' },
  { q: 'Δέχεστε ασφαλιστικά ταμεία;', a: 'Συνεργαζόμαστε με τα κυριότερα ταμεία και εκδίδουμε τις απαραίτητες βεβαιώσεις.' },
  { q: 'Κάθε πότε να έρχομαι;', a: 'Συνιστούμε έλεγχο και καθαρισμό κάθε 6 μήνες για υγιές χαμόγελο.' },
  { q: 'Αναλαμβάνετε παιδιά;', a: 'Ναι, με ειδική φροντίδα και φιλική προσέγγιση για τα παιδιά.' },
];
---

<div class="dent">
  <!-- Topbar -->
  <div class="topbar">
    <div class="wrap topbar-inner">
      <span>Έκτακτο περιστατικό; Καλέστε μας</span>
      <span class="topbar-right">
        <a href="tel:2100000000">210 000 0000</a>
        <span class="sep">·</span>
        <span>Δευ–Παρ · 09:00–20:00</span>
      </span>
    </div>
  </div>

  <!-- Nav -->
  <header class="nav">
    <div class="wrap nav-inner">
      <a class="brand" href="#top">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M9.34 2.34a4.5 4.5 0 0 0-6.36 4.5c.4 2.5 1.4 4.5 1.9 7.5.3 1.9.6 3.3 1.6 3.3 1.2 0 1.2-2 1.8-4 .3-1 .8-1.6 1.7-1.6s1.4.6 1.7 1.6c.6 2 .6 4 1.8 4 1 0 1.3-1.4 1.6-3.3.5-3 1.5-5 1.9-7.5a4.5 4.5 0 0 0-6.36-4.5l-1.34 1z"/></svg>
        </span>
        <span class="brand-name">{brand}<small>Σύγχρονη Οδοντιατρική</small></span>
      </a>
      <nav class="links">
        <a href="#services">Υπηρεσίες</a>
        <a href="#team">Ομάδα</a>
        <a href="#prices">Τιμές</a>
        <a href="#faq">Συχνές ερωτήσεις</a>
      </nav>
      <a href="#booking" class="nav-cta">Κλείσε ραντεβού</a>
    </div>
  </header>

  <!-- Hero -->
  <section class="hero" id="top">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">Οδοντιατρείο · Σαλαμίνα</span>
        <h1>Ένα χαμόγελο που θα λατρέψετε.</h1>
        <p>
          Σύγχρονη οδοντιατρική φροντίδα σε ένα ήρεμο, αποστειρωμένο περιβάλλον. Κλείστε το ραντεβού
          σας online, χωρίς αναμονή.
        </p>
        <div class="hero-cta">
          <a href="#booking" class="btn btn-solid">Κλείσε ραντεβού</a>
          <a href="#services" class="btn btn-ghost">Οι υπηρεσίες μας</a>
        </div>
        <div class="hero-meta">
          <span><strong>15+</strong> χρόνια φροντίδας</span>
          <span><strong>4,9★</strong> 500+ κριτικές</span>
        </div>
      </div>
      <div class="hero-art" aria-hidden="true">
        <div class="tooth-card">
          <span class="tooth-shape">
            <svg viewBox="0 0 24 24" width="72" height="72" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M9.34 2.34a4.5 4.5 0 0 0-6.36 4.5c.4 2.5 1.4 4.5 1.9 7.5.3 1.9.6 3.3 1.6 3.3 1.2 0 1.2-2 1.8-4 .3-1 .8-1.6 1.7-1.6s1.4.6 1.7 1.6c.6 2 .6 4 1.8 4 1 0 1.3-1.4 1.6-3.3.5-3 1.5-5 1.9-7.5a4.5 4.5 0 0 0-6.36-4.5l-1.34 1z"/></svg>
          </span>
          <span class="spark s1"></span>
          <span class="spark s2"></span>
        </div>
        <div class="hero-pill">Ανώδυνη φροντίδα</div>
      </div>
    </div>
  </section>

  <!-- Trust -->
  <section class="trust">
    <div class="wrap trust-grid">
      {trust.map((t) => (
        <div class="titem">
          <span class="ticon" aria-hidden="true">✓</span>
          <div><strong>{t.title}</strong><span>{t.text}</span></div>
        </div>
      ))}
    </div>
  </section>

  <!-- Services -->
  <section class="section" id="services">
    <div class="wrap">
      <div class="head center">
        <span class="eyebrow">Υπηρεσίες</span>
        <h2>Φροντίδα για κάθε ανάγκη</h2>
        <p>Από τον προληπτικό καθαρισμό μέχρι τα εμφυτεύματα — όλα σε ένα σύγχρονο ιατρείο.</p>
      </div>
      <div class="services-grid">
        {services.map((s) => (
          <article class="scard">
            <h3>{s.name}</h3>
            <p>{s.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Team -->
  <section class="section section--soft" id="team">
    <div class="wrap">
      <div class="head center">
        <span class="eyebrow">Η ομάδα</span>
        <h2>Γνωρίστε τους οδοντιάτρους μας</h2>
      </div>
      <div class="team-grid">
        {team.map((m) => (
          <article class="member">
            <div class="member-avatar" aria-hidden="true">{m.name.replace('Δρ. ', '').charAt(0)}</div>
            <h3>{m.name}</h3>
            <span class="member-role">{m.role}</span>
            <span class="member-field">{m.field}</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Prices -->
  <section class="section" id="prices">
    <div class="wrap price-grid">
      <div>
        <span class="eyebrow">Τιμές</span>
        <h2>Διαφανείς, ενδεικτικές τιμές</h2>
        <p class="price-lead">Η τελική τιμή καθορίζεται μετά την κλινική εξέταση. Πάντα ενημερώνεστε πριν ξεκινήσουμε.</p>
        <a href="#booking" class="btn btn-solid">Κλείσε ραντεβού</a>
      </div>
      <ul class="price-list">
        {prices.map((p) => (
          <li><span>{p.name}</span><strong>{p.price}</strong></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Reviews -->
  <section class="section section--soft">
    <div class="wrap">
      <div class="head center">
        <span class="eyebrow">Αξιολογήσεις</span>
        <h2>Τι λένε οι ασθενείς μας</h2>
      </div>
      <div class="rev-grid">
        {reviews.map((r) => (
          <figure class="rev">
            <div class="stars">★★★★★</div>
            <blockquote>{r.text}</blockquote>
            <figcaption>{r.name}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" id="faq">
    <div class="wrap faq-wrap">
      <div class="head center">
        <span class="eyebrow">Συχνές ερωτήσεις</span>
        <h2>Ό,τι ρωτούν συχνότερα</h2>
      </div>
      <div class="faq-list">
        {faq.map((f) => (
          <details class="faq-item">
            <summary>{f.q}<span class="faq-plus" aria-hidden="true">+</span></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Booking -->
  <section class="section section--soft" id="booking">
    <div class="wrap booking-grid">
      <div class="booking-copy">
        <span class="eyebrow">Ραντεβού</span>
        <h2>Κλείσε το ραντεβού σου</h2>
        <p>Συμπλήρωσε τη φόρμα και θα λάβεις επιβεβαίωση. Για έκτακτα περιστατικά, τηλεφώνησέ μας.</p>
        <ul class="booking-info">
          <li><span>Τηλέφωνο</span><a href="tel:2100000000">210 000 0000</a></li>
          <li><span>Email</span><a href="mailto:info@dentia.gr">info@dentia.gr</a></li>
          <li><span>Διεύθυνση</span><strong>Βασ. Γεωργίου 20, Σαλαμίνα</strong></li>
          <li><span>Ώρες</span><strong>Δευ–Παρ · 09:00–20:00</strong></li>
        </ul>
      </div>
      <form class="booking-form" onsubmit="event.preventDefault(); this.reset();">
        <div class="form-2">
          <input type="text" placeholder="Ονοματεπώνυμο" required />
          <input type="tel" placeholder="Τηλέφωνο" required />
        </div>
        <input type="email" placeholder="Email" required />
        <select required>
          <option value="">Υπηρεσία</option>
          <option>Καθαρισμός & έλεγχος</option>
          <option>Σφράγισμα</option>
          <option>Λεύκανση</option>
          <option>Εμφύτευμα</option>
          <option>Ορθοδοντική</option>
          <option>Παιδοδοντιατρική</option>
        </select>
        <div class="form-2">
          <input type="date" required />
          <input type="time" required />
        </div>
        <button type="submit" class="btn btn-solid btn-block">Ζήτα ραντεβού</button>
        <small>Ενδεικτική φόρμα demo — δεν αποστέλλει δεδομένα.</small>
      </form>
    </div>
  </section>

  <footer class="footer">
    <div class="wrap foot-inner">
      <span class="brand brand-foot">{brand}<small>Σύγχρονη Οδοντιατρική</small></span>
      <span>© 2026 {brand} · Οδοντιατρείο στη Σαλαμίνα.</span>
    </div>
  </footer>
</div>

<style>
  .dent {
    --bg: #f4fafb;
    --paper: #ffffff;
    --teal: #0d9488;
    --teal-d: #0b7d73;
    --deep: #103844;
    --sky: #e0f5f6;
    --muted: #5b7480;
    --line: #dbeaec;
    background: var(--paper);
    color: #15323a;
    font-family: 'Inter', system-ui, sans-serif;
    line-height: 1.68;
  }

  .wrap {
    max-width: 1140px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .dent h1,
  .dent h2,
  .dent h3 {
    font-family: 'Outfit', system-ui, sans-serif;
    color: var(--deep);
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .dent h1 {
    font-size: clamp(2.2rem, 4.8vw, 3.3rem);
    line-height: 1.1;
  }

  .dent h2 {
    font-size: clamp(1.7rem, 3.2vw, 2.3rem);
    margin: 10px 0 12px;
  }

  .eyebrow {
    display: inline-block;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--teal);
  }

  /* Topbar */
  .topbar {
    background: var(--teal);
    color: #d3f0ee;
    font-size: 0.8rem;
  }

  .topbar-inner {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 9px 24px;
    flex-wrap: wrap;
  }

  .topbar a {
    color: #fff;
    text-decoration: none;
  }

  .topbar .sep {
    margin: 0 8px;
  }

  /* Nav */
  .nav {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    height: 78px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }

  .brand-mark {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--sky);
    color: var(--teal);
  }

  .brand-name {
    display: flex;
    flex-direction: column;
    font-family: 'Outfit', sans-serif;
    font-weight: 700;
    font-size: 1.42rem;
    color: var(--deep);
    line-height: 1;
  }

  .brand-name small {
    font-family: 'Inter', sans-serif;
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--teal);
    margin-top: 5px;
  }

  .links {
    display: flex;
    gap: 26px;
    font-size: 0.93rem;
    font-weight: 600;
  }

  .links a {
    color: #33525a;
    text-decoration: none;
  }

  .links a:hover {
    color: var(--teal);
  }

  .nav-cta {
    background: var(--teal);
    color: #fff;
    font-weight: 600;
    font-size: 0.88rem;
    padding: 12px 24px;
    border-radius: 999px;
    text-decoration: none;
    transition: background 0.2s ease;
  }

  .nav-cta:hover {
    background: var(--teal-d);
  }

  /* Hero */
  .hero {
    background:
      radial-gradient(80% 90% at 100% 0%, var(--sky), transparent 60%),
      var(--bg);
    padding: 80px 0;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 56px;
    align-items: center;
  }

  .hero-copy p {
    color: var(--muted);
    font-size: 1.1rem;
    margin: 20px 0 30px;
    max-width: 50ch;
  }

  .hero-cta {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 28px;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.94rem;
    text-decoration: none;
    cursor: pointer;
    border: 1.5px solid transparent;
    font-family: inherit;
    transition: transform 0.18s ease, background 0.18s ease;
  }

  .btn-solid {
    background: var(--teal);
    color: #fff;
  }

  .btn-solid:hover {
    background: var(--teal-d);
    transform: translateY(-2px);
  }

  .btn-ghost {
    border-color: rgba(16, 56, 68, 0.2);
    color: var(--deep);
    background: #fff;
  }

  .btn-ghost:hover {
    border-color: var(--deep);
  }

  .btn-block {
    width: 100%;
  }

  .hero-meta {
    display: flex;
    gap: 30px;
    margin-top: 32px;
    padding-top: 22px;
    border-top: 1px solid var(--line);
    flex-wrap: wrap;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .hero-meta strong {
    font-family: 'Outfit', sans-serif;
    font-size: 1.4rem;
    color: var(--teal);
    margin-right: 4px;
  }

  .hero-art {
    position: relative;
    display: grid;
    place-items: center;
    height: 380px;
  }

  .tooth-card {
    position: relative;
    width: 300px;
    height: 300px;
    border-radius: 40px;
    background: linear-gradient(160deg, #ffffff, var(--sky));
    border: 1px solid var(--line);
    display: grid;
    place-items: center;
    color: var(--teal);
    box-shadow: 0 40px 80px -50px rgba(13, 148, 136, 0.6);
  }

  .spark {
    position: absolute;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #67e8f9;
    box-shadow: 0 0 0 6px rgba(103, 232, 249, 0.25);
  }

  .s1 { top: 34px; right: 52px; }
  .s2 { bottom: 44px; left: 46px; }

  .hero-pill {
    position: absolute;
    bottom: 14px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 10px 20px;
    font-weight: 600;
    font-size: 0.86rem;
    color: var(--deep);
    box-shadow: 0 18px 36px -24px rgba(16, 56, 68, 0.5);
  }

  /* Trust */
  .trust {
    background: var(--deep);
    color: #b7d3d6;
    padding: 32px 0;
  }

  .trust-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .titem {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }

  .ticon {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--teal);
    color: #fff;
    display: grid;
    place-items: center;
    font-size: 0.8rem;
    flex-shrink: 0;
  }

  .titem strong {
    display: block;
    color: #fff;
    font-family: 'Outfit', sans-serif;
    margin-bottom: 2px;
  }

  .titem span {
    font-size: 0.84rem;
  }

  /* Sections */
  .section {
    padding: 84px 0;
  }

  .section--soft {
    background: var(--bg);
  }

  .head {
    max-width: 620px;
    margin-bottom: 44px;
  }

  .head.center {
    text-align: center;
    margin-left: auto;
    margin-right: auto;
  }

  .head p {
    color: var(--muted);
    font-size: 1.02rem;
    margin-top: 6px;
  }

  /* Services */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .scard {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 26px;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }

  .scard:hover {
    transform: translateY(-5px);
    box-shadow: 0 26px 50px -40px rgba(13, 148, 136, 0.6);
  }

  .scard h3 {
    font-size: 1.06rem;
    margin-bottom: 8px;
  }

  .scard p {
    color: var(--muted);
    font-size: 0.9rem;
  }

  /* Team */
  .team-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .member {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 32px;
    text-align: center;
  }

  .member-avatar {
    width: 84px;
    height: 84px;
    margin: 0 auto 18px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-family: 'Outfit', sans-serif;
    font-size: 2rem;
    font-weight: 600;
    color: var(--teal);
    background: var(--sky);
  }

  .member h3 {
    font-size: 1.2rem;
  }

  .member-role {
