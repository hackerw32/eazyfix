---
const brand = 'ESTIA';
const listings = [
  { title: 'Διαμέρισμα στα Παλούκια', area: 'Παλούκια', type: 'Πώληση', rooms: '2 υπνοδ.', sqm: '95 τ.μ.', price: '165.000€', tone: 'a', featured: true },
  { title: 'Μονοκατοικία με κήπο', area: 'Σελήνια', type: 'Πώληση', rooms: '3 υπνοδ.', sqm: '180 τ.μ.', price: '320.000€', tone: 'b' },
  { title: 'Διαμέρισμα στο Κέντρο', area: 'Κέντρο', type: 'Ενοικίαση', rooms: '1 υπνοδ.', sqm: '60 τ.μ.', price: '520€/μήνα', tone: 'c' },
  { title: 'Οικόπεδο εντός σχεδίου', area: 'Αμπελάκια', type: 'Πώληση', rooms: '450 τ.μ.', sqm: '', price: '55.000€', tone: 'd' },
  { title: 'Μεζονέτα με θέα', area: 'Αιάντειο', type: 'Πώληση', rooms: '4 υπνοδ.', sqm: '210 τ.μ.', price: '395.000€', tone: 'e' },
  { title: 'Επαγγελματικός χώρος', area: 'Κέντρο', type: 'Ενοικίαση', rooms: '80 τ.μ.', sqm: '', price: '650€/μήνα', tone: 'f' },
];
const services = [
  { title: 'Εκτίμηση ακινήτου', text: 'Δωρεάν και τεκμηριωμένη εκτίμηση της αξίας του ακινήτου σας.' },
  { title: 'Επαγγελματική φωτογράφηση', text: 'Φωτογραφίες και βίντεο που αναδεικνύουν το ακίνητο.' },
  { title: 'Νομική υποστήριξη', text: 'Έλεγχος τίτλων και συνεργασία με έμπειρους δικηγόρους.' },
  { title: 'Διαχείριση ακινήτων', text: 'Αναλαμβάνουμε ενοικιάσεις και διαχείριση για λογαριασμό σας.' },
];
const stats = [
  { value: '14', label: 'χρόνια στη Σαλαμίνα' },
  { value: '480+', label: 'ακίνητα σε συνεργασία' },
  { value: '100%', label: 'έλεγχος τίτλων' },
  { value: '4,9/5', label: 'ικανοποίηση πελατών' },
];
const reviews = [
  { name: 'Γιώργος & Μαρία', text: 'Βρήκαν το σπίτι που ψάχναμε σε 3 εβδομάδες. Επαγγελματίες, χωρίς πίεση.' },
  { name: 'Κατερίνα Ρ.', text: 'Εκτίμηση δωρεάν και ρεαλιστική. Πούλησα γρήγορα και στην τιμή που έπρεπε.' },
  { name: 'Δημήτρης Λ.', text: 'Άψογη συνεργασία σε όλη τη διαδικασία. Τους εμπιστεύομαι απόλυτα.' },
];
---

<div class="estia">
  <!-- Topbar -->
  <div class="topbar">
    <div class="wrap topbar-inner">
      <span>Δωρεάν εκτίμηση ακινήτου</span>
      <span class="topbar-right">
        <a href="tel:2100000000">210 000 0000</a>
        <span class="sep">·</span>
        <span>info@estia.gr</span>
      </span>
    </div>
  </div>

  <!-- Nav -->
  <header class="nav">
    <div class="wrap nav-inner">
      <a class="brand" href="#top">
        <span class="brand-name">{brand}<small>Real Estate</small></span>
      </a>
      <nav class="links">
        <a href="#listings">Αγγελίες</a>
        <a href="#services">Υπηρεσίες</a>
        <a href="#about">Το γραφείο</a>
        <a href="#contact">Επικοινωνία</a>
      </nav>
      <a href="#contact" class="nav-cta">Εκτίμηση</a>
    </div>
  </header>

  <!-- Hero -->
  <section class="hero" id="top">
    <div class="wrap hero-inner">
      <span class="eyebrow">Μεσιτικό γραφείο · Σαλαμίνα</span>
      <h1>Βρείτε τον χώρο που θα ονομάσετε σπίτι.</h1>
      <p>Επιλεγμένα ακίνητα στη Σαλαμίνα, με διαφάνεια, έλεγχο τίτλων και προσωπική καθοδήγηση σε κάθε βήμα.</p>
      <form class="search" onsubmit="event.preventDefault();">
        <div class="sf">
          <label>Περιοχή</label>
          <select>
            <option>Όλες οι περιοχές</option>
            <option>Κέντρο</option>
            <option>Παλούκια</option>
            <option>Σελήνια</option>
            <option>Αιάντειο</option>
            <option>Αμπελάκια</option>
          </select>
        </div>
        <div class="sf">
          <label>Τύπος</label>
          <select>
            <option>Όλα</option>
            <option>Διαμέρισμα</option>
            <option>Μονοκατοικία</option>
            <option>Οικόπεδο</option>
            <option>Επαγγελματικό</option>
          </select>
        </div>
        <div class="sf">
          <label>Συναλλαγή</label>
          <select>
            <option>Αγορά & Ενοικίαση</option>
            <option>Αγορά</option>
            <option>Ενοικίαση</option>
          </select>
        </div>
        <button type="submit" class="search-btn">Αναζήτηση</button>
      </form>
    </div>
  </section>

  <!-- Featured -->
  <section class="featured">
    <div class="wrap">
      <div class="feat-card">
        <div class="feat-img tone-a">
          <span class="feat-badge">Προτεινόμενο</span>
        </div>
        <div class="feat-body">
          <span class="feat-cat">Διαμέρισμα · Παλούκια</span>
          <h2>Διαμέρισμα 95 τ.μ. με θέα στη θάλασσα</h2>
          <p>Δύο υπνοδωμάτια, φωτεινό σαλόνι, μεγάλο μπαλκόνι και θέση στάθμευσης. Έτοιμο για άμεση μετακόμιση.</p>
          <div class="feat-meta">
            <span>2 υπνοδωμάτια</span>
            <span>1 μπάνιο</span>
            <span>95 τ.μ.</span>
          </div>
          <div class="feat-foot">
            <span class="feat-price">165.000€</span>
            <a href="#listings" class="btn btn-solid">Δες λεπτομέρειες</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Listings -->
  <section class="section" id="listings">
    <div class="wrap">
      <div class="list-head">
        <div>
          <span class="eyebrow">Αγγελίες</span>
          <h2>Επιλεγμένα ακίνητα</h2>
        </div>
        <div class="chips">
          <button class="chip active">Όλα</button>
          <button class="chip">Πώληση</button>
          <button class="chip">Ενοικίαση</button>
          <button class="chip">Οικόπεδα</button>
        </div>
      </div>
      <div class="listing-grid">
        {listings.map((l) => (
          <article class="lcard">
            <div class={`limg tone-${l.tone}`}>
              <span class:list={['lbadge', l.type === 'Πώληση' ? 'lb-sale' : 'lb-rent']}>{l.type}</span>
            </div>
            <div class="lbody">
              <span class="larea">{l.area}</span>
              <h3>{l.title}</h3>
              <div class="lmeta">
                <span>{l.rooms}</span>
                {l.sqm && <span>{l.sqm}</span>}
              </div>
              <div class="lfoot">
                <span class="lprice">{l.price}</span>
                <span class="lmore">Λεπτομέρειες →</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="section section--soft" id="services">
    <div class="wrap">
      <div class="head center">
        <span class="eyebrow">Υπηρεσίες</span>
        <h2>Πέρα από μια αγγελία</h2>
        <p>Αναλαμβάνουμε όλη τη διαδικασία, από την εκτίμηση μέχρι την υπογραφή.</p>
      </div>
      <div class="services-grid">
        {services.map((s, i) => (
          <article class="scard">
            <span class="snum">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- About + stats -->
  <section class="section" id="about">
    <div class="wrap about-grid">
      <div class="about-art" aria-hidden="true">
        <div class="about-img"></div>
      </div>
      <div class="about-copy">
        <span class="eyebrow">Το γραφείο</span>
        <h2>Τοπική γνώση, προσωπική εξυπηρέτηση</h2>
        <p>
          Είμαστε ένα boutique μεσιτικό γραφείο στη Σαλαμίνα. Δουλεύουμε με λίγα, επιλεγμένα ακίνητα
          ώστε κάθε πελάτης να έχει την προσοχή που του αξίζει — χωρίς περιττές αγγελίες και πίεση.
        </p>
        <div class="stats">
          {stats.map((st) => (
            <div class="stat">
              <strong>{st.value}</strong>
              <span>{st.label}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Reviews -->
  <section class="section section--soft">
    <div class="wrap">
      <div class="head center">
        <span class="eyebrow">Πελάτες</span>
        <h2>Τι λένε για εμάς</h2>
      </div>
      <div class="rev-grid">
        {reviews.map((r) => (
          <figure class="rev">
            <div class="stars">★★★★★</div>
            <blockquote>{r.text}</blockquote>
            <figcaption>{r.name}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section class="section" id="contact">
    <div class="wrap contact-grid">
      <div class="contact-copy">
        <span class="eyebrow">Εκτίμηση &amp; επικοινωνία</span>
        <h2>Μάθετε την αξία του ακινήτου σας</h2>
        <p>Αφήστε τα στοιχεία σας και θα σας καλέσουμε για δωρεάν εκτίμηση, χωρίς καμία δέσμευση.</p>
        <ul class="contact-list">
          <li><span>Τηλέφωνο</span><a href="tel:2100000000">210 000 0000</a></li>
          <li><span>Email</span><a href="mailto:info@estia.gr">info@estia.gr</a></li>
          <li><span>Γραφείο</span><strong>Ακτή Μιαούλη 12, Σαλαμίνα</strong></li>
        </ul>
      </div>
      <form class="contact-form" onsubmit="event.preventDefault(); this.reset();">
        <div class="form-2">
          <input type="text" placeholder="Ονοματεπώνυμο" required />
          <input type="tel" placeholder="Τηλέφωνο" required />
        </div>
        <input type="email" placeholder="Email" required />
        <select required>
          <option value="">Ενδιαφέρομαι για</option>
          <option>Πώληση ακινήτου</option>
          <option>Αγορά ακινήτου</option>
          <option>Ενοικίαση</option>
          <option>Εκτίμηση αξίας</option>
        </select>
        <textarea rows="3" placeholder="Περιοχή & σύντομη περιγραφή"></textarea>
        <button type="submit" class="btn btn-solid btn-block">Ζήτα εκτίμηση</button>
        <small>Ενδεικτική φόρμα demo — δεν αποστέλλει δεδομένα.</small>
      </form>
    </div>
  </section>

  <footer class="footer">
    <div class="wrap foot-inner">
      <span class="brand brand-foot">{brand}<small>Real Estate</small></span>
      <span>© 2026 {brand} Real Estate · Μεσιτικό γραφείο στη Σαλαμίνα.</span>
    </div>
  </footer>
</div>

<style>
  .estia {
    --bg: #f5f2ec;
    --paper: #fffdfa;
    --ink: #1b1d1c;
    --emerald: #1f5e4c;
    --emerald-d: #164536;
    --gold: #b08a4f;
    --muted: #6b6f6c;
    --line: #e4ddd1;
    background: var(--paper);
    color: var(--ink);
    font-family: 'Inter', system-ui, sans-serif;
    line-height: 1.7;
  }

  .wrap {
    max-width: 1160px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .estia h1,
  .estia h2,
  .estia h3 {
    font-family: 'Fraunces', Georgia, serif;
    color: var(--ink);
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 0;
  }

  .estia h1 {
    font-size: clamp(2.4rem, 5.4vw, 3.8rem);
    line-height: 1.06;
  }

  .estia h2 {
    font-size: clamp(1.8rem, 3.4vw, 2.5rem);
    margin: 10px 0 12px;
  }

  .eyebrow {
    display: inline-block;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--emerald);
  }

  /* Topbar */
  .topbar {
    background: var(--emerald);
    color: #cfe0d8;
    font-size: 0.8rem;
  }

  .topbar-inner {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 9px 24px;
    flex-wrap: wrap;
  }

  .topbar a {
    color: #fff;
    text-decoration: none;
  }

  .topbar .sep {
    margin: 0 8px;
  }

  /* Nav */
  .nav {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(255, 253, 250, 0.94);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    height: 84px;
  }

  .brand-name {
    display: flex;
    flex-direction: column;
    font-family: 'Fraunces', serif;
    font-weight: 700;
    font-size: 1.6rem;
    letter-spacing: 0.16em;
    color: var(--ink);
    line-height: 1;
  }

  .brand-name small {
    font-family: 'Inter', sans-serif;
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: var(--gold);
    margin-top: 5px;
  }

  .links {
    display: flex;
    gap: 28px;
    font-size: 0.94rem;
    font-weight: 500;
  }

  .links a {
    color: #3a413d;
    text-decoration: none;
  }

  .links a:hover {
    color: var(--emerald);
  }

  .nav-cta {
    background: var(--emerald);
    color: #fff;
    font-weight: 600;
    font-size: 0.88rem;
    padding: 12px 24px;
    border-radius: 999px;
    text-decoration: none;
    transition: background 0.2s ease;
  }

  .nav-cta:hover {
    background: var(--emerald-d);
  }

  /* Hero */
  .hero {
    background:
      radial-gradient(80% 90% at 100% 0%, #eaf0ea, transparent 60%),
      var(--bg);
    padding: 90px 0 60px;
  }

  .hero-inner {
    max-width: 820px;
  }

  .hero p {
    color: var(--muted);
    font-size: 1.14rem;
    margin: 22px 0 34px;
    max-width: 54ch;
  }

  .search {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr auto;
    gap: 12px;
    align-items: end;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 18px;
    box-shadow: 0 30px 60px -50px rgba(27, 29, 28, 0.7);
  }

  .sf {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .sf label {
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
  }

  .search select {
    width: 100%;
    padding: 12px;
    border: 1.5px solid var(--line);
    border-radius: 10px;
    font-family: inherit;
    font-size: 0.92rem;
    color: var(--ink);
    background: #fff;
  }

  .search select:focus {
    outline: none;
    border-color: var(--emerald);
  }

  .search-btn {
    border: none;
    background: var(--emerald);
    color: #fff;
    font-weight: 700;
    font-size: 0.95rem;
    padding: 13px 28px;
    border-radius: 10px;
    cursor: pointer;
    font-family: inherit;
    height: 47px;
  }

  .search-btn:hover {
    background: var(--emerald-d);
  }

  /* Featured */
  .featured {
    padding: 40px 0 20px;
  }

  .feat-card {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 0;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 22px;
    overflow: hidden;
    box-shadow: 0 40px 80px -60px rgba(27, 29, 28, 0.8);
  }

  .feat-img {
    position: relative;
    min-height: 360px;
  }

  .tone-a { background: linear-gradient(150deg, #2a5c4c, #143a2f); }
  .tone-b { background: linear-gradient(150deg, #4a5a6a, #232c36); }
  .tone-c { background: linear-gradient(150deg, #7a6a52, #4a3f2f); }
  .tone-d { background: linear-gradient(150deg, #5d6b4a, #333d28); }
  .tone-e { background: linear-gradient(150deg, #6a5a6e, #38303c); }
  .tone-f { background: linear-gradient(150deg, #556b73, #2b3a40); }

  .feat-badge {
    position: absolute;
    top: 20px;
    left: 20px;
    background: #fff;
    color: var(--emerald);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 7px 15px;
    border-radius: 999px;
  }

  .feat-body {
    padding: 44px;
    display: flex;
    flex-direction: column;
  }

  .feat-cat {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .feat-body h2 {
    font-size: clamp(1.6rem, 2.6vw, 2.1rem);
    margin: 12px 0 14px;
  }

  .feat-body p {
    color: var(--muted);
    font-size: 1rem;
    flex: 1;
  }

  .feat-meta {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
    margin: 20px 0;
    color: #3a413d;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .feat-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    border-top: 1px solid var(--line);
    padding-top: 22px;
    flex-wrap: wrap;
  }

  .feat-price {
    font-family: 'Fraunces', serif;
    font-size: 1.8rem;
    color: var(--ink);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 13px 26px;
    border-radius: 10px;
    font-weight: 700;
    font-size: 0.92rem;
    text-decoration: none;
    cursor: pointer;
    border: 1.5px solid transparent;
    font-family: inherit;
    transition: background 0.18s ease, transform 0.18s ease;
  }

  .btn-solid {
    background: var(--emerald);
    color: #fff;
  }

  .btn-solid:hover {
    background: var(--emerald-d);
    transform: translateY(-2px);
  }

  .btn-block {
    width: 100%;
  }

  /* Sections */
  .section {
    padding: 84px 0;
  }

  .section--soft {
    background: var(--bg);
  }

  .head {
    max-width: 620px;
    margin-bottom: 44px;
  }

  .head.center {
    text-align: center;
    margin-left: auto;
    margin-right: auto;
  }

  .head p {
    color: var(--muted);
    font-size: 1.03rem;
    margin-top: 6px;
  }

  .list-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    margin-bottom: 34px;
  }

  .chips {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .chip {
    padding: 9px 18px;
    border-radius: 999px;
    border: 1.5px solid var(--line);
    background: #fff;
    color: var(--muted);
    font-weight: 600;
    font-size: 0.85rem;
    cursor: pointer;
    font-family: inherit;
  }

  .chip.active {
    background: var(--emerald);
    border-color: var(--emerald);
    color: #fff;
  }

  .listing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 26px;
  }

  .lcard {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 18px;
    overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    cursor: pointer;
  }

  .lcard:hover {
    transform: translateY(-6px);
    border-color: transparent;
    box-shadow: 0 30px 50px -40px rgba(27, 29, 28, 0.7);
  }

  .limg {
    position: relative;
    height: 200px;
  }

  .lbadge {
    position: absolute;
    top: 14px;
    left: 14px;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 5px 12px;
    border-radius: 999px;
    color: #fff;
  }

  .lb-sale { background: var(--emerald); }
  .lb-rent { background: var(--gold); }

  .lbody {
    padding: 22px;
  }

  .larea {
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .lbody h3 {
    font-size: 1.15rem;
    margin: 8px 0 12px;
  }

  .lmeta {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    color: var(--muted);
    font-size: 0.85rem;
    margin-bottom: 16px;
  }

  .lfoot {
    display: flex;
