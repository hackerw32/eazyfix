---
const brand = 'GEOΔΟΜΗ';
const pillars = [
  {
    tag: 'Μεσιτικό',
    title: 'Ακίνητα',
    points: ['Αγορά & πώληση ακινήτων', 'Ενοικιάσεις κατοικιών & επαγγελματικών', 'Έλεγχος τίτλων & νομικός καθαρισμός', 'Δωρεάν εκτίμηση αξίας'],
  },
  {
    tag: 'Τεχνικό γραφείο',
    title: 'Τεχνικές Υπηρεσίες',
    points: ['Τοπογραφικά διαγράμματα', 'ΚΥΔ & τακτοποίηση αυθαιρέτων', 'Οριοθετήσεις & ευρέσεις οικοπέδων', 'Τεχνικοί έλεγχοι & ΠΕΑ'],
  },
];
const listings = [
  { title: 'Διαμέρισμα 95 τ.μ.', area: 'Παλούκια', price: '165.000€', type: 'Πώληση' },
  { title: 'Μονοκατοικία 180 τ.μ.', area: 'Σελήνια', price: '320.000€', type: 'Πώληση' },
  { title: 'Οικόπεδο 450 τ.μ.', area: 'Αμπελάκια', price: '55.000€', type: 'Πώληση' },
  { title: 'Επαγγελματικός χώρος', area: 'Κέντρο', price: '650€/μήνα', type: 'Ενοικίαση' },
];
const tech = [
  { name: 'Τοπογραφικά διαγράμματα', text: 'Αποτυπώσεις, σχέδια και τίτλοι για κάθε ακίνητο.' },
  { name: 'ΚΥΔ & Τακτοποιήσεις', text: 'Ρύθμιση αυθαιρέτων & ΚΥΔ με έκδοση βεβαίωσης.' },
  { name: 'Οριοθετήσεις & Ευρέσεις', text: 'Τοποθέτηση ορίων και εύρεση οικοπέδων στο έδαφος.' },
  { name: 'Τεχνικοί έλεγχοι', text: 'Πραγματογνωμοσύνες και αυτοψίες ακινήτων.' },
  { name: 'Ενεργειακά Πιστοποιητικά', text: 'Έκδοση ΠΕΑ σύμφωνα με την κείμενη νομοθεσία.' },
  { name: 'Άδειες μικρής κλίμακας', text: 'Εργασίες και επεμβάσεις με έκδοση άδειας.' },
];
const steps = [
  { title: 'Αυτοψία', text: 'Επισκεπτόμαστε το ακίνητο και συλλέγουμε δεδομένα.' },
  { title: 'Μελέτη', text: 'Συντάσσουμε τα τεχνικά σχέδια και τον φάκελο.' },
  { title: 'Κατάθεση', text: 'Καταθέτουμε στον αρμόδιο φορέα (Κτηματολόγιο / Υπηρεσία).' },
  { title: 'Έγκριση', text: 'Παρακολουθούμε τη διαδικασία μέχρι το τελικό έγγραφο.' },
];
const stats = [
  { value: '14', label: 'χρόνια εμπειρίας' },
  { value: '300+', label: 'τεχνικοί φάκελοι' },
  { value: '480+', label: 'ακίνητα' },
  { value: '100%', label: 'έλεγχος τίτλων' },
];
const reviews = [
  { name: 'Στέλιος Μ.', text: 'Τακτοποίησαν το αυθαίρετο και βρήκαν αγοραστή. Όλα σε ένα γραφείο.' },
  { name: 'Έφη Κ.', text: 'Το τοπογραφικό ήταν άψογο και η όλη διαδικασία χωρίς ταλαιπωρία.' },
  { name: 'Νίκος Α.', text: 'Σοβαροί, οργανωμένοι και ακριβείς. Ευχαριστώ για την καθοδήγηση.' },
];
---

<div class="geo">
  <!-- Topbar -->
  <div class="topbar">
    <div class="wrap topbar-inner">
      <span>Ακίνητα &amp; Τεχνικό Γραφείο · Σαλαμίνα</span>
      <span class="topbar-right">
        <a href="tel:2100000000">210 000 0000</a>
        <span class="sep">·</span>
        <span>info@geodomi.gr</span>
      </span>
    </div>
  </div>

  <!-- Nav -->
  <header class="nav">
    <div class="wrap nav-inner">
      <a class="brand" href="#top">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18M5 21V8l7-5 7 5v13M9 21v-6h6v6"/></svg>
        </span>
        <span class="brand-name">{brand}<small>Real Estate &amp; Engineering</small></span>
      </a>
      <nav class="links">
        <a href="#pillars">Υπηρεσίες</a>
        <a href="#listings">Ακίνητα</a>
        <a href="#tech">Τεχνικά</a>
        <a href="#contact">Επικοινωνία</a>
      </nav>
      <a href="#contact" class="nav-cta">Επικοινωνία</a>
    </div>
  </header>

  <!-- Hero -->
  <section class="hero" id="top">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">Real Estate &amp; Engineering</span>
        <h1>Ακίνητα &amp; τεχνικές υπηρεσίες, σε ένα γραφείο.</h1>
        <p>
          Αναλαμβάνουμε την πώληση, ενοικίαση και τεχνική διεκπεραίωση του ακινήτου σας: τοπογραφικά,
          τακτοποιήσεις αυθαιρέτων, οριοθετήσεις και τεχνικούς ελέγχους — με έναν υπεύθυνο.
        </p>
        <div class="hero-cta">
          <a href="#listings" class="btn btn-solid">Δες τα ακίνητα</a>
          <a href="#tech" class="btn btn-ghost">Τεχνικές υπηρεσίες</a>
        </div>
        <div class="hero-tags">
          <span>Έλεγχος τίτλων</span>
          <span>ΚΥΔ / Αυθαίρετα</span>
          <span>Τοπογραφικά</span>
          <span>ΠΕΑ</span>
        </div>
      </div>
      <div class="hero-panel" aria-hidden="true">
        <div class="panel-row"><span>Ακίνητα ενεργά</span><strong>24</strong></div>
        <div class="panel-row"><span>Τεχνικοί φάκελοι</span><strong>300+</strong></div>
        <div class="panel-row"><span>Αποτυπώσεις</span><strong>450+</strong></div>
        <div class="panel-row"><span>Ικανοποίηση</span><strong>4,9★</strong></div>
      </div>
    </div>
  </section>

  <!-- Pillars -->
  <section class="section" id="pillars">
    <div class="wrap">
      <div class="head center">
        <span class="eyebrow">Δύο ειδικότητες, μία υπηρεσία</span>
        <h2>Μεσιτικό &amp; Τεχνικό Γραφείο</h2>
      </div>
      <div class="pillar-grid">
        {pillars.map((p) => (
          <article class="pillar">
            <span class="pillar-tag">{p.tag}</span>
            <h3>{p.title}</h3>
            <ul>
              {p.points.map((pt) => (
                <li><span class="tick" aria-hidden="true"></span>{pt}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Listings -->
  <section class="section section--soft" id="listings">
    <div class="wrap">
      <div class="head">
        <span class="eyebrow">Ακίνητα</span>
        <h2>Επιλεγμένες αγγελίες</h2>
        <p>Με πλήρη έλεγχο τίτλων και τεχνική ενημέρωση για κάθε ακίνητο.</p>
      </div>
      <div class="listing-grid">
        {listings.map((l) => (
          <article class="litem">
            <span class:list={['ltag', l.type === 'Πώληση' ? 'lt-sale' : 'lt-rent']}>{l.type}</span>
            <h3>{l.title}</h3>
            <span class="larea">{l.area}</span>
            <div class="lrow">
              <span class="lprice">{l.price}</span>
              <span class="lmore">Λεπτομέρειες →</span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Technical -->
  <section class="section" id="tech">
    <div class="wrap">
      <div class="head center">
        <span class="eyebrow">Τεχνικό γραφείο</span>
        <h2>Τεχνικές υπηρεσίες</h2>
        <p>Από την αποτύπωση έως την έγκριση — με υπευθυνότητα και τήρηση προθεσμιών.</p>
      </div>
      <div class="tech-grid">
        {tech.map((t, i) => (
          <article class="tcard">
            <span class="tnum">{String(i + 1).padStart(2, '0')}</span>
            <h3>{t.name}</h3>
            <p>{t.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="section section--dark">
    <div class="wrap">
      <div class="head center">
        <span class="eyebrow eyebrow--light">Διαδικασία</span>
        <h2>Πώς διεκπεραιώνουμε μια τεχνική υπόθεση</h2>
      </div>
      <ol class="steps">
        {steps.map((s, i) => (
          <li>
            <span class="step-num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Stats -->
  <section class="stats">
    <div class="wrap stats-grid">
      {stats.map((st) => (
        <div><strong>{st.value}</strong><span>{st.label}</span></div>
      ))}
    </div>
  </section>

  <!-- Reviews -->
  <section class="section section--soft">
    <div class="wrap">
      <div class="head center">
        <span class="eyebrow">Πελάτες</span>
        <h2>Συνεργασίες που κρατούν</h2>
      </div>
      <div class="rev-grid">
        {reviews.map((r) => (
          <figure class="rev">
            <div class="stars">★★★★★</div>
            <blockquote>{r.text}</blockquote>
            <figcaption>{r.name}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section class="section" id="contact">
    <div class="wrap contact-grid">
      <div class="contact-copy">
        <span class="eyebrow">Επικοινωνία</span>
        <h2>Πες μας τι χρειάζεσαι</h2>
        <p>Είτε πρόκειται για ακίνητο είτε για τεχνική υπηρεσία, θα σε καθοδηγήσουμε με σαφήνεια.</p>
        <ul class="contact-list">
          <li><span>Τηλέφωνο</span><a href="tel:2100000000">210 000 0000</a></li>
          <li><span>Email</span><a href="mailto:info@geodomi.gr">info@geodomi.gr</a></li>
          <li><span>Γραφείο</span><strong>Ακτή Κονδύλη 7, Σαλαμίνα</strong></li>
          <li><span>Ώρες</span><strong>Δευ–Παρ · 09:00–17:00</strong></li>
        </ul>
      </div>
      <form class="contact-form" onsubmit="event.preventDefault(); this.reset();">
        <div class="form-2">
          <input type="text" placeholder="Ονοματεπώνυμο" required />
          <input type="tel" placeholder="Τηλέφωνο" required />
        </div>
        <input type="email" placeholder="Email" required />
        <select required>
          <option value="">Τι χρειάζεσαι;</option>
          <option>Αγορά / πώληση ακινήτου</option>
          <option>Ενοικίαση</option>
          <option>Τοπογραφικό διάγραμμα</option>
          <option>ΚΥΔ / Τακτοποίηση αυθαιρέτου</option>
          <option>Οριοθέτηση / Εύρεση οικοπέδου</option>
          <option>Τεχνικός έλεγχος / ΠΕΑ</option>
        </select>
        <textarea rows="3" placeholder="Στοιχεία ακινήτου ή περιγραφή"></textarea>
        <button type="submit" class="btn btn-solid btn-block">Αποστολή αιτήματος</button>
        <small>Ενδεικτική φόρμα demo — δεν αποστέλλει δεδομένα.</small>
      </form>
    </div>
  </section>

  <footer class="footer">
    <div class="wrap foot-inner">
      <span class="brand brand-foot">{brand}<small>Real Estate &amp; Engineering</small></span>
      <span>© 2026 {brand} · Μεσιτικό &amp; Τεχνικό Γραφείο · Σαλαμίνα.</span>
    </div>
  </footer>
</div>

<style>
  .geo {
    --bg: #f3f5f8;
    --paper: #ffffff;
    --navy: #0f1e33;
    --navy-2: #16263e;
    --steel: #2b4a6f;
    --amber: #e08a1e;
    --amber-d: #c4760f;
    --muted: #64748b;
    --line: #dde3ea;
    background: var(--paper);
    color: #16233a;
    font-family: 'Inter', system-ui, sans-serif;
    line-height: 1.65;
  }

  .wrap {
    max-width: 1160px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .geo h1,
  .geo h2,
  .geo h3 {
    font-family: 'Space Grotesk', system-ui, sans-serif;
    color: var(--navy);
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .geo h1 {
    font-size: clamp(2.1rem, 4.6vw, 3.2rem);
    line-height: 1.1;
  }

  .geo h2 {
    font-size: clamp(1.7rem, 3.2vw, 2.3rem);
    margin: 10px 0 12px;
  }

  .eyebrow {
    display: inline-block;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--steel);
  }

  .eyebrow--light {
    color: #8fb4e0;
  }

  /* Topbar */
  .topbar {
    background: var(--navy);
    color: #9fb2c9;
    font-size: 0.8rem;
  }

  .topbar-inner {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 9px 24px;
    flex-wrap: wrap;
  }

  .topbar a {
    color: #fff;
    text-decoration: none;
  }

  .topbar .sep {
    margin: 0 8px;
  }

  /* Nav */
  .nav {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    height: 78px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }

  .brand-mark {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    display: grid;
    place-items: center;
    background: var(--navy);
    color: #fff;
  }

  .brand-name {
    display: flex;
    flex-direction: column;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: 1.3rem;
    letter-spacing: 0.04em;
    color: var(--navy);
    line-height: 1;
  }

  .brand-name small {
    font-family: 'Inter', sans-serif;
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--steel);
    margin-top: 5px;
  }

  .links {
    display: flex;
    gap: 28px;
    font-size: 0.93rem;
    font-weight: 600;
  }

  .links a {
    color: #33475f;
    text-decoration: none;
  }

  .links a:hover {
    color: var(--amber);
  }

  .nav-cta {
    background: var(--navy);
    color: #fff;
    font-weight: 600;
    font-size: 0.88rem;
    padding: 12px 24px;
    border-radius: 9px;
    text-decoration: none;
    transition: background 0.2s ease;
  }

  .nav-cta:hover {
    background: var(--amber);
  }

  /* Hero */
  .hero {
    background:
      linear-gradient(rgba(43, 74, 111, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(43, 74, 111, 0.06) 1px, transparent 1px),
      linear-gradient(180deg, #eaf0f7, var(--paper));
    background-size: 42px 42px, 42px 42px, 100% 100%;
    padding: 84px 0;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 56px;
    align-items: center;
  }

  .hero-copy p {
    color: var(--muted);
    font-size: 1.1rem;
    margin: 20px 0 30px;
    max-width: 54ch;
  }

  .hero-cta {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 26px;
    border-radius: 9px;
    font-weight: 700;
    font-size: 0.94rem;
    text-decoration: none;
    cursor: pointer;
    border: 1.5px solid transparent;
    font-family: inherit;
    transition: transform 0.18s ease, background 0.18s ease;
  }

  .btn-solid {
    background: var(--navy);
    color: #fff;
  }

  .btn-solid:hover {
    background: var(--navy-2);
    transform: translateY(-2px);
  }

  .btn-ghost {
    border-color: var(--line);
    color: var(--navy);
    background: #fff;
  }

  .btn-ghost:hover {
    border-color: var(--navy);
  }

  .btn-block {
    width: 100%;
  }

  .hero-tags {
    display: flex;
    gap: 9px;
    flex-wrap: wrap;
    margin-top: 26px;
  }

  .hero-tags span {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--steel);
    background: #fff;
    border: 1px solid var(--line);
    padding: 6px 13px;
    border-radius: 8px;
  }

  .hero-panel {
    background: var(--navy);
    border-radius: 16px;
    padding: 30px;
    box-shadow: 0 40px 80px -50px rgba(15, 30, 51, 0.9);
  }

  .panel-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .panel-row:last-child {
    border-bottom: 0;
  }

  .panel-row span {
    color: #9fb2c9;
    font-size: 0.9rem;
  }

  .panel-row strong {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.5rem;
    color: #fff;
  }

  /* Sections */
  .section {
    padding: 84px 0;
  }

  .section--soft {
    background: var(--bg);
  }

  .section--dark {
    background: var(--navy);
    color: #b7c5d6;
  }

  .section--dark h2 {
    color: #fff;
  }

  .head {
    max-width: 640px;
    margin-bottom: 44px;
  }

  .head.center {
    text-align: center;
    margin-left: auto;
    margin-right: auto;
  }

  .head p {
    color: var(--muted);
    font-size: 1.02rem;
    margin-top: 6px;
  }

  /* Pillars */
  .pillar-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 26px;
  }

  .pillar {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 36px;
    border-top: 3px solid var(--amber);
  }

  .pillar-tag {
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--amber);
  }

  .pillar h3 {
    font-size: 1.6rem;
    margin: 10px 0 20px;
  }

  .pillar ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }

  .pillar li {
    display: flex;
    align-items: center;
    gap: 12px;
    font-weight: 500;
    color: #33475f;
  }

  .tick {
    width: 20px;
    height: 20px;
    border-radius: 6px;
    background: rgba(224, 138, 30, 0.14);
    position: relative;
    flex-shrink: 0;
  }

  .tick::after {
    content: '';
    position: absolute;
    left: 7px;
    top: 4px;
    width: 5px;
    height: 9px;
    border: solid var(--amber);
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }

  /* Listings */
  .listing-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .litem {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 24px;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }

  .litem:hover {
    transform: translateY(-5px);
    box-shadow: 0 26px 46px -34px rgba(15, 30, 51, 0.6);
  }

  .ltag {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 4px 11px;
    border-radius: 7px;
    margin-bottom: 14px;
  }

  .lt-sale {
    background: rgba(43, 74, 111, 0.12);
    color: var(--steel);
  }

  .lt-rent {
    background: rgba(224, 138, 30, 0.14);
    color: var(--amber-d);
  }

  .litem h3 {
    font-size: 1.08rem;
    margin-bottom: 4px;
  }

  .larea {
    color: var(--muted);
    font-size: 0.86rem;
  }

  .lrow {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }

  .lprice {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    color: var(--navy);
  }

  .lmore {
    font-size: 0.8rem;
