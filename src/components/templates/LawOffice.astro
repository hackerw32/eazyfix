---
const firm = 'Ν. Δημητρίου & Συνεργάτες';
const practice = [
  { name: 'Αστικό Δίκαιο', text: 'Συμβάσεις, απαιτήσεις, αποζημιώσεις και διεκδικήσεις.' },
  { name: 'Εργατικό Δίκαιο', text: 'Απολύσεις, δεδουλευμένα, εργατικά ατυχήματα.' },
  { name: 'Εταιρικό & Εμπορικό', text: 'Σύσταση εταιρειών, συμβάσεις, συμμόρφωση.' },
  { name: 'Ακίνητα', text: 'Μεταβιβάσεις, μισθώσεις, έλεγχος τίτλων.' },
  { name: 'Οικογενειακό Δίκαιο', text: 'Διαζύγια, διατροφές, επιμέλεια τέκνων.' },
  { name: 'Ποινικό Δίκαιο', text: 'Υπεράσπιση και εκπροσώπηση σε ποινικές υποθέσεις.' },
];
const values = [
  { title: 'Εμπιστοσύνη', text: 'Χτίζουμε σχέση εμπιστοσύνης με κάθε εντολέα, με ειλικρίνεια.' },
  { title: 'Διαφάνεια', text: 'Καθαρές αμοιβές και συνεχής ενημέρωση για την πορεία της υπόθεσης.' },
  { title: 'Εμπειρία', text: 'Δύο δεκαετίες ενασχόλησης με υποθέσεις κάθε βαθμού δυσκολίας.' },
];
const team = [
  { name: 'Νικόλαος Δημητρίου', role: 'Ιδρυτής · Δικηγόρος παρ’ Αρείω Πάγω', field: 'Αστικό & Εταιρικό Δίκαιο' },
  { name: 'Μαρία Σταύρου', role: 'Δικηγόρος', field: 'Εργατικό Δίκαιο & Ακίνητα' },
  { name: 'Γιώργος Λάμπρου', role: 'Δικηγόρος', field: 'Ποινικό & Οικογενειακό Δίκαιο' },
];
const steps = [
  { title: 'Πρώτη επικοινωνία', text: 'Ακούμε το ζήτημά σας — η πρώτη συνάντηση είναι δωρεάν.' },
  { title: 'Αξιολόγηση', text: 'Μελετάμε έγγραφα και δεδομένα και αποτυπώνουμε τις επιλογές.' },
  { title: 'Στρατηγική', text: 'Σχεδιάζουμε τη βέλτιστη νομική γραμμή και τα βήματα.' },
  { title: 'Εκπροσώπηση', text: 'Αναλαμβάνουμε τη διεκπεραίωση ή/και τη δικαστική εκπροσώπηση.' },
];
const reviews = [
  { name: 'Επιχείρηση Α.Ε.', text: 'Άρτια ενημέρωση και ουσιαστική υποστήριξη σε πολύπλοκη εταιρική υπόθεση.' },
  { name: 'Μιχάλης Γ.', text: 'Επαγγελματισμός, συνέπεια και ανθρώπινη προσέγγιση από την πρώτη στιγμή.' },
  { name: 'Άννα Π.', text: 'Με καθοδήγησαν με σαφήνεια και διακριτικότητα. Τους εμπιστεύομαι απόλυτα.' },
];
const faq = [
  { q: 'Πόσο κοστίζει μια νομική συμβουλή;', a: 'Η πρώτη συνάντηση για αξιολόγηση της υπόθεσης είναι δωρεάν. Οι αμοιβές καθορίζονται με σαφήνεια πριν την ανάληψη.' },
  { q: 'Πόσο διαρκεί μια υπόθεση;', a: 'Ο χρόνος εξαρτάται από το είδος και τη δικαστική ύλη. Σας ενημερώνουμε ρεαλιστικά από την αρχή.' },
  { q: 'Αναλαμβάνετε υποθέσεις εκτός Αττικής;', a: 'Ναι, αναλαμβάνουμε υποθέσεις σε όλη την Ελλάδα, με δικαστική εκπροσώπηση.' },
  { q: 'Τηρείται το απόρρητο;', a: 'Απόλυτα. Κάθε πληροφορία αντιμετωπίζεται με εμπιστευτικότητα και επαγγελματικό απόρρητο.' },
];
---

<div class="law">
  <!-- Topbar -->
  <div class="topbar">
    <div class="wrap topbar-inner">
      <span>Δωρεάν πρώτη συνάντηση αξιολόγησης</span>
      <span class="topbar-right">
        <a href="tel:2100000000">210 000 0000</a>
        <span class="dot">·</span>
        <a href="mailto:info@dimitriou-law.gr">info@dimitriou-law.gr</a>
      </span>
    </div>
  </div>

  <!-- Nav -->
  <header class="nav">
    <div class="wrap nav-inner">
      <a class="brand" href="#top">
        <span class="monogram">ΝΔ</span>
        <span class="brand-name">{firm}<small>Δικηγορικό Γραφείο</small></span>
      </a>
      <nav class="links">
        <a href="#practice">Τομείς</a>
        <a href="#about">Το γραφείο</a>
        <a href="#team">Δικηγόροι</a>
        <a href="#faq">Συχνές ερωτήσεις</a>
      </nav>
      <a href="#contact" class="nav-cta">Ραντεβού</a>
    </div>
  </header>

  <!-- Hero -->
  <section class="hero" id="top">
    <div class="wrap hero-inner">
      <span class="eyebrow">Δικηγορικό Γραφείο · Σαλαμίνα &amp; Αθήνα</span>
      <h1>Νομική εκπροσώπηση με συνέπεια και διακριτικότητα</h1>
      <p>
        Το γραφείο μας παρέχει ολοκληρωμένη νομική υποστήριξη σε ιδιώτες και επιχειρήσεις.
        Αναλαμβάνουμε κάθε υπόθεση με σοβαρότητα, σαφήνεια στη στρατηγική και απόλυτη εχεμύθεια.
      </p>
      <div class="hero-cta">
        <a href="#contact" class="btn btn-solid">Κλείστε ραντεβού</a>
        <a href="#practice" class="btn btn-ghost">Τομείς πρακτικής</a>
      </div>
      <div class="hero-rule"></div>
      <div class="hero-trust">
        <span>Από το <strong>2004</strong></span>
        <span>Υποθέσεις σε όλη την Ελλάδα</span>
        <span>Πρώτη συνάντηση <strong>δωρεάν</strong></span>
      </div>
    </div>
  </section>

  <!-- Practice -->
  <section class="section" id="practice">
    <div class="wrap">
      <div class="head center">
        <span class="eyebrow">Τομείς πρακτικής</span>
        <h2>Ολοκληρωμένη νομική κάλυψη</h2>
        <p>Εξειδίκευση σε έξι βασικούς τομείς, με προσωπική ενασχόληση σε κάθε υπόθεση.</p>
      </div>
      <div class="practice-grid">
        {practice.map((p, i) => (
          <article class="pcard">
            <span class="pnum">{String(i + 1).padStart(2, '0')}</span>
            <h3>{p.name}</h3>
            <p>{p.text}</p>
            <span class="plink">Περισσότερα →</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- About / values -->
  <section class="section section--dark" id="about">
    <div class="wrap about-grid">
      <div class="about-copy">
        <span class="eyebrow eyebrow--light">Το γραφείο</span>
        <h2>Σοβαρότητα, σαφήνεια, αποτέλεσμα</h2>
        <p>
          Ιδρύθηκε το 2004 και έκτοτε εκπροσωπεί με συνέπεια εντολείς σε αστικές, εργατικές,
          εταιρικές και ποινικές υποθέσεις. Στόχος μας είναι η ουσιαστική επίλυση του ζητήματός σας —
          όχι απλώς η τυπική διεκπεραίωση.
        </p>
        <div class="values">
          {values.map((v) => (
            <div class="value">
              <h4>{v.title}</h4>
              <p>{v.text}</p>
            </div>
          ))}
        </div>
      </div>
      <div class="about-art" aria-hidden="true">
        <div class="about-frame">
          <span class="about-mark">⚖</span>
        </div>
        <span class="about-caption">Από το 2004 δίπλα στον εντολέα</span>
      </div>
    </div>
  </section>

  <!-- Team -->
  <section class="section" id="team">
    <div class="wrap">
      <div class="head center">
        <span class="eyebrow">Η ομάδα</span>
        <h2>Οι δικηγόροι μας</h2>
      </div>
      <div class="team-grid">
        {team.map((m) => (
          <article class="member">
            <div class="member-avatar" aria-hidden="true">{m.name.split(' ').map((w) => w[0]).join('')}</div>
            <h3>{m.name}</h3>
            <span class="member-role">{m.role}</span>
            <span class="member-field">{m.field}</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="stats">
    <div class="wrap stats-grid">
      <div><strong>20+</strong><span>χρόνια εμπειρίας</span></div>
      <div><strong>1.200+</strong><span>υποθέσεις</span></div>
      <div><strong>98%</strong><span>θετικές αποφάσεις</span></div>
      <div><strong>4,9/5</strong><span>ικανοποίηση εντολέων</span></div>
    </div>
  </section>

  <!-- Process -->
  <section class="section section--soft">
    <div class="wrap">
      <div class="head center">
        <span class="eyebrow">Πώς δουλεύουμε</span>
        <h2>Μια σαφής πορεία για την υπόθεσή σας</h2>
      </div>
      <ol class="steps">
        {steps.map((s, i) => (
          <li>
            <span class="step-num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Reviews -->
  <section class="section">
    <div class="wrap">
      <div class="head center">
        <span class="eyebrow">Εντολείς</span>
        <h2>Η γνώμη των εντολέων μας</h2>
      </div>
      <div class="rev-grid">
        {reviews.map((r) => (
          <figure class="rev">
            <div class="stars">★★★★★</div>
            <blockquote>“{r.text}”</blockquote>
            <figcaption>{r.name}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section--soft" id="faq">
    <div class="wrap faq-wrap">
      <div class="head center">
        <span class="eyebrow">Συχνές ερωτήσεις</span>
        <h2>Χρήσιμες απαντήσεις</h2>
      </div>
      <div class="faq-list">
        {faq.map((f) => (
          <details class="faq-item">
            <summary>{f.q}<span class="faq-plus" aria-hidden="true">+</span></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section class="section" id="contact">
    <div class="wrap contact-grid">
      <div class="contact-copy">
        <span class="eyebrow">Ραντεβού</span>
        <h2>Συζητήστε την υπόθεσή σας</h2>
        <p>
          Η πρώτη συνάντηση αξιολόγησης είναι δωρεάν. Συμπληρώστε τη φόρμα και θα επικοινωνήσουμε
          μαζί σας εντός μίας εργάσιμης ημέρας, με απόλυτη εχεμύθεια.
        </p>
        <ul class="contact-list">
          <li><span>Τηλέφωνο</span><a href="tel:2100000000">210 000 0000</a></li>
          <li><span>Email</span><a href="mailto:info@dimitriou-law.gr">info@dimitriou-law.gr</a></li>
          <li><span>Διεύθυνση</span><strong>Ακτή Κονδύλη 7, Σαλαμίνα</strong></li>
          <li><span>Ώρες</span><strong>Δευ–Παρ · 09:00–17:00</strong></li>
        </ul>
      </div>
      <form class="contact-form" onsubmit="event.preventDefault(); this.reset();">
        <div class="form-2">
          <input type="text" placeholder="Ονοματεπώνυμο" required />
          <input type="tel" placeholder="Τηλέφωνο" required />
        </div>
        <input type="email" placeholder="Email" required />
        <select required>
          <option value="">Τομέας</option>
          <option>Αστικό Δίκαιο</option>
          <option>Εργατικό Δίκαιο</option>
          <option>Εταιρικό & Εμπορικό</option>
          <option>Ακίνητα</option>
          <option>Οικογενειακό</option>
          <option>Ποινικό</option>
        </select>
        <textarea rows="4" placeholder="Περιγράψτε σύντομα το ζήτημά σας..." required></textarea>
        <button type="submit" class="btn btn-solid btn-block">Αποστολή αιτήματος</button>
        <small>Τα στοιχεία σας τηρούνται εμπιστευτικά. Ενδεικτική φόρμα demo.</small>
      </form>
    </div>
  </section>

  <footer class="footer">
    <div class="wrap foot-inner">
      <span class="brand brand-foot">
        <span class="monogram monogram--foot">ΝΔ</span>
        <span class="brand-name">{firm}</span>
      </span>
      <span class="foot-note">© 2026 {firm}. Ο παρών ιστότοπος αποτελεί δείγμα (demo) και δεν συνιστά νομική συμβουλή.</span>
    </div>
  </footer>
</div>

<style>
  .law {
    --ivory: #f7f5f0;
    --paper: #fffdf9;
    --navy: #16202e;
    --navy-2: #1e2c3f;
    --gold: #a5852e;
    --char: #23282e;
    --muted: #6b7280;
    --line: #e4dfd4;
    background: var(--paper);
    color: var(--char);
    font-family: 'Lato', system-ui, sans-serif;
    line-height: 1.7;
  }

  .wrap {
    max-width: 1140px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .law h1,
  .law h2,
  .law h3,
  .law h4 {
    font-family: 'Cormorant Garamond', Georgia, serif;
    color: var(--navy);
    font-weight: 600;
    letter-spacing: 0.01em;
    margin: 0;
  }

  .law h1 {
    font-size: clamp(2.3rem, 5vw, 3.6rem);
    line-height: 1.1;
  }

  .law h2 {
    font-size: clamp(1.9rem, 3.6vw, 2.7rem);
    margin: 12px 0 14px;
  }

  .eyebrow {
    display: inline-block;
    font-family: 'Lato', sans-serif;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .eyebrow--light {
    color: #d9c179;
  }

  /* Topbar */
  .topbar {
    background: var(--navy);
    color: #a9b4c2;
    font-size: 0.8rem;
    letter-spacing: 0.02em;
  }

  .topbar-inner {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 9px 24px;
    flex-wrap: wrap;
  }

  .topbar a {
    color: #e9e2d2;
    text-decoration: none;
  }

  .topbar .dot {
    margin: 0 8px;
  }

  /* Nav */
  .nav {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(255, 253, 249, 0.95);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    height: 82px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 13px;
    text-decoration: none;
  }

  .monogram {
    width: 46px;
    height: 46px;
    border: 1.5px solid var(--gold);
    color: var(--gold);
    display: grid;
    place-items: center;
    font-family: 'Cormorant Garamond', serif;
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: 0.04em;
  }

  .brand-name {
    display: flex;
    flex-direction: column;
    font-family: 'Cormorant Garamond', serif;
    font-weight: 700;
    font-size: 1.22rem;
    color: var(--navy);
    line-height: 1.15;
  }

  .brand-name small {
    font-family: 'Lato', sans-serif;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .links {
    display: flex;
    gap: 28px;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .links a {
    color: #3d4652;
    text-decoration: none;
  }

  .links a:hover {
    color: var(--gold);
  }

  .nav-cta {
    border: 1.5px solid var(--navy);
    color: var(--navy);
    font-weight: 700;
    font-size: 0.86rem;
    letter-spacing: 0.04em;
    padding: 11px 22px;
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .nav-cta:hover {
    background: var(--navy);
    color: #fff;
  }

  /* Hero */
  .hero {
    background:
      radial-gradient(120% 120% at 50% -20%, rgba(165, 133, 46, 0.1), transparent 55%),
      var(--ivory);
    padding: 84px 0;
    text-align: center;
    border-bottom: 1px solid var(--line);
  }

  .hero-inner {
    max-width: 820px;
  }

  .hero h1 {
    margin: 20px 0 22px;
  }

  .hero p {
    color: var(--muted);
    font-size: 1.14rem;
    max-width: 62ch;
    margin: 0 auto 32px;
  }

  .hero-cta {
    display: flex;
    gap: 14px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 30px;
    font-weight: 700;
    font-size: 0.9rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    border: 1.5px solid var(--navy);
    font-family: 'Lato', sans-serif;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .btn-solid {
    background: var(--navy);
    color: #fff;
  }

  .btn-solid:hover {
    background: #0f1822;
  }

  .btn-ghost {
    background: transparent;
    color: var(--navy);
  }

  .btn-ghost:hover {
    background: var(--navy);
    color: #fff;
  }

  .btn-block {
    width: 100%;
  }

  .hero-rule {
    width: 70px;
    height: 2px;
    background: var(--gold);
    margin: 46px auto 22px;
  }

  .hero-trust {
    display: flex;
    justify-content: center;
    gap: 34px;
    flex-wrap: wrap;
    color: var(--muted);
    font-size: 0.86rem;
    letter-spacing: 0.02em;
  }

  .hero-trust strong {
    color: var(--navy);
  }

  /* Sections */
  .section {
    padding: 88px 0;
  }

  .section--soft {
    background: var(--ivory);
  }

  .section--dark {
    background: var(--navy);
    color: #cfd6df;
  }

  .section--dark h2 {
    color: #fff;
  }

  .head {
    max-width: 640px;
    margin-bottom: 48px;
  }

  .head.center {
    text-align: center;
    margin-left: auto;
    margin-right: auto;
  }

  .head p {
    color: var(--muted);
    font-size: 1.05rem;
    margin-top: 8px;
  }

  /* Practice */
  .practice-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }

  .pcard {
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: 36px 30px;
    background: var(--paper);
    transition: background 0.2s ease;
  }

  .pcard:hover {
    background: var(--ivory);
  }

  .pnum {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.5rem;
    color: var(--gold);
    font-weight: 700;
  }

  .pcard h3 {
    font-size: 1.4rem;
    margin: 12px 0 10px;
  }

  .pcard p {
    color: var(--muted);
    font-size: 0.95rem;
    margin-bottom: 14px;
  }

  .plink {
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--gold);
  }

  /* About */
  .about-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 60px;
    align-items: center;
  }

  .about-copy p {
    color: #c3ccd7;
    font-size: 1.05rem;
    margin-top: 12px;
  }

  .values {
    display: grid;
    gap: 20px;
    margin-top: 30px;
  }

  .value {
    border-left: 2px solid var(--gold);
    padding-left: 18px;
  }

  .value h4 {
    color: #fff;
    font-size: 1.2rem;
  }

  .value p {
    color: #aab6c4;
    font-size: 0.94rem;
  }

  .about-art {
    position: relative;
  }

  .about-frame {
    height: 380px;
    border: 1px solid rgba(165, 133, 46, 0.4);
    display: grid;
    place-items: center;
    background: linear-gradient(160deg, #1e2c3f, #101a26);
  }

  .about-mark {
    font-size: 5rem;
    color: var(--gold);
    opacity: 0.85;
  }

  .about-caption {
    position: absolute;
    bottom: -14px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--navy);
    border: 1px solid rgba(165, 133, 46, 0.4);
    color: #d9c179;
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    padding: 8px 18px;
    white-space: nowrap;
  }

  /* Team */
