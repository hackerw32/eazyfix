---
import Icon from './Icon.astro';

interface Props {
  webdev: {
    badge: Record<string, string>;
    title: Record<string, string>;
    subtitle: Record<string, string>;
    features: { icon: string; title: Record<string, string>; description: Record<string, string> }[];
    ctaText: Record<string, string>;
    ctaLink: string;
  };
  locale: 'el' | 'en';
}

const { webdev, locale } = Astro.props;
const ctaLink = locale === 'en' ? '/en/templates' : '/templates';
---

<section id="webdev" class="webdev">
  <div class="webdev-glow" aria-hidden="true"></div>
  <div class="container">
    <div class="section-head section-head--center webdev-head">
      <span class="eyebrow eyebrow--light">{webdev.badge[locale]}</span>
      <h2 class="h2">{webdev.title[locale]}</h2>
      <p class="lead lead--light">{webdev.subtitle[locale]}</p>
    </div>

    <div class="webdev-grid">
      {webdev.features.map((feature) => (
        <article class="webdev-card">
          <span class="webdev-icon"><Icon name={feature.icon} /></span>
          <h3>{feature.title[locale]}</h3>
          <p>{feature.description[locale]}</p>
        </article>
      ))}
    </div>

    <div class="webdev-cta">
      <a href={ctaLink} class="btn btn--primary">
        {webdev.ctaText[locale]}
        <Icon name="arrow-right" size={18} />
      </a>
    </div>
  </div>
</section>

<style>
  .webdev {
    position: relative;
    overflow: hidden;
    background: var(--ink);
    color: #fff;
    padding: 104px 0;
  }

  .webdev-glow {
    position: absolute;
    left: -10%;
    bottom: -40%;
    width: 640px;
    height: 640px;
    background: radial-gradient(circle at center, rgba(14, 165, 233, 0.28), transparent 62%);
  }

  .webdev-head {
    position: relative;
    max-width: 760px;
  }

  .eyebrow--light {
    color: #a5b4fc;
  }

  .eyebrow--light::before {
    background: #a5b4fc;
  }

  .webdev-head .h2 {
    color: #fff;
  }

  .lead--light {
    color: #cbd5e1;
    margin-left: auto;
    margin-right: auto;
  }

  .webdev-grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 12px;
  }

  .webdev-card {
    background: rgba(255, 255, 255, 0.045);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius);
    padding: 28px;
    transition: border-color 0.2s ease, transform 0.2s ease, background 0.2s ease;
  }

  .webdev-card:hover {
    border-color: rgba(165, 180, 252, 0.5);
    transform: translateY(-4px);
    background: rgba(255, 255, 255, 0.07);
  }

  .webdev-icon {
    width: 46px;
    height: 46px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    background: rgba(129, 140, 248, 0.16);
    color: #c7d2fe;
    margin-bottom: 18px;
  }

  .webdev-icon svg {
    width: 23px;
    height: 23px;
  }

  .webdev-card h3 {
    color: #fff;
    font-size: 1.08rem;
    margin-bottom: 8px;
  }

  .webdev-card p {
    color: #94a3b8;
    font-size: 0.94rem;
  }

  .webdev-cta {
    position: relative;
    text-align: center;
    margin-top: 48px;
  }

  @media (max-width: 980px) {
    .webdev-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 620px) {
    .webdev-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
