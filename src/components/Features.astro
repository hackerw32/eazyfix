---
import Icon from './Icon.astro';

interface Props {
  features: { icon: string; title: Record<string, string>; description: Record<string, string> }[];
  locale: 'el' | 'en';
}

const { features, locale } = Astro.props;
const eyebrow = locale === 'en' ? 'Why EazyFix' : 'Γιατί EazyFix';
const heading = locale === 'en' ? 'Service you can rely on' : 'Υπηρεσίες που μπορείτε να εμπιστευτείτε';
---

<section id="features" class="section section--soft">
  <div class="container">
    <div class="section-head section-head--center">
      <span class="eyebrow">{eyebrow}</span>
      <h2 class="h2">{heading}</h2>
    </div>

    <div class="features-grid">
      {features.map((feature) => (
        <article class="feature">
          <span class="icon-badge"><Icon name={feature.icon} /></span>
          <h3 class="h3">{feature.title[locale]}</h3>
          <p>{feature.description[locale]}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .features-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 28px;
  }

  .feature h3 {
    margin-bottom: 10px;
    font-size: 1.12rem;
  }

  .feature p {
    color: var(--muted);
    font-size: 0.95rem;
  }

  @media (max-width: 980px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .features-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
