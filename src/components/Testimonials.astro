---
import Icon from './Icon.astro';

interface Props {
  testimonials: { name: string; location: Record<string, string>; text: Record<string, string>; rating: number }[];
  locale: 'el' | 'en';
}

const { testimonials, locale } = Astro.props;
const eyebrow = locale === 'en' ? 'Reviews' : 'Μαρτυρίες';
const heading = locale === 'en' ? 'What clients say' : 'Τι λένε οι πελάτες μου';
---

<section id="testimonials" class="section">
  <div class="container">
    <div class="section-head section-head--center">
      <span class="eyebrow">{eyebrow}</span>
      <h2 class="h2">{heading}</h2>
    </div>

    <div class="testimonials-grid">
      {testimonials.map((testimonial) => (
        <figure class="testimonial card">
          <span class="quote-icon"><Icon name="quote" size={26} /></span>
          <div class="stars">
            {Array.from({ length: testimonial.rating }).map(() => (
              <Icon name="star" size={16} />
            ))}
          </div>
          <blockquote>{testimonial.text[locale]}</blockquote>
          <figcaption>
            <strong>{testimonial.name}</strong>
            <span>{testimonial.location[locale]}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .testimonial {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin: 0;
  }

  .quote-icon {
    color: var(--primary);
    opacity: 0.35;
  }

  .stars {
    display: flex;
    gap: 3px;
    color: #f59e0b;
  }

  .stars svg {
    fill: currentColor;
  }

  blockquote {
    margin: 0;
    color: var(--ink-soft);
    font-size: 1rem;
    flex: 1;
  }

  figcaption {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--line);
    padding-top: 16px;
  }

  figcaption strong {
    font-family: var(--font-head);
  }

  figcaption span {
    color: var(--muted);
    font-size: 0.88rem;
  }

  @media (max-width: 980px) {
    .testimonials-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
