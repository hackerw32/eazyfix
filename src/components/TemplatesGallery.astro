---
import Icon from './Icon.astro';
import TemplateCard from './TemplateCard.astro';
import { templates } from '../data/templates';

interface Props {
  locale: 'el' | 'en';
}

const { locale } = Astro.props;

const copy =
  locale === 'en'
    ? {
        eyebrow: 'Templates & Portfolio',
        title: 'Choose a profession, open a live demo',
        lead: 'Each template is a fully functional page with realistic placeholder content. Click one to browse it as a real visitor would.',
        note: 'Need something different? I build every website from scratch, exactly to your needs.',
        cta: 'Request a custom website',
      }
    : {
        eyebrow: 'Πρότυπα & Portfolio',
        title: 'Διάλεξε επάγγελμα, άνοιξε ένα live demo',
        lead: 'Κάθε πρότυπο είναι μια πλήρως λειτουργική σελίδα με ρεαλιστικό περιεχόμενο. Πατήστε σε ένα για να το περιηγηθείτε όπως ένας πραγματικός επισκέπτης.',
        note: 'Χρειάζεστε κάτι διαφορετικό; Κάθε ιστοσελίδα χτίζεται από το μηδέν, ακριβώς στα μέτρα σας.',
        cta: 'Ζητήστε στα μέτρα σας',
      };
---

<section class="page-hero">
  <div class="page-hero-glow" aria-hidden="true"></div>
  <div class="container">
    <span class="eyebrow eyebrow--light">{copy.eyebrow}</span>
    <h1 class="page-title">{copy.title}</h1>
    <p class="page-lead">{copy.lead}</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="gallery-grid">
      {templates.map((template) => (
        <TemplateCard template={template} locale={locale} />
      ))}
    </div>

    <div class="gallery-note">
      <p>{copy.note}</p>
      <a href="/#contact" class="btn btn--primary">
        {copy.cta}
        <Icon name="arrow-right" size={18} />
      </a>
    </div>
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    background: var(--ink);
    color: #fff;
    padding: 84px 0 72px;
  }

  .page-hero-glow {
    position: absolute;
    inset: -40% -10% auto auto;
    width: 620px;
    height: 620px;
    background: radial-gradient(circle at center, rgba(99, 102, 241, 0.4), transparent 62%);
  }

  .page-hero .container {
    position: relative;
    max-width: 820px;
  }

  .page-title {
    color: #fff;
    font-size: clamp(2rem, 4.4vw, 3rem);
  }

  .page-lead {
    color: #cbd5e1;
    font-size: 1.1rem;
    margin-top: 20px;
    max-width: 60ch;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }

  .gallery-note {
    margin-top: 64px;
    text-align: center;
    background: var(--bg-soft);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 40px;
  }

  .gallery-note p {
    font-size: 1.1rem;
    font-family: var(--font-head);
    margin-bottom: 22px;
  }

  @media (max-width: 980px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .gallery-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
