---
import Icon from './Icon.astro';

interface Props {
  services: { id: string; icon: string; title: Record<string, string>; description: Record<string, string>; price: string }[];
  locale: 'el' | 'en';
}

const { services, locale } = Astro.props;
const heading = locale === 'en' ? 'Repair services' : 'Υπηρεσίες επισκευής';
const eyebrow = locale === 'en' ? 'Services' : 'Υπηρεσίες';
const lead =
  locale === 'en'
    ? 'Expert diagnosis and repair for every device, on site and by appointment.'
    : 'Έμπειρη διάγνωση και επισκευή για κάθε συσκευή, στο χώρο σας και κατόπιν ραντεβού.';
---

<section id="services" class="section">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">{eyebrow}</span>
      <h2 class="h2">{heading}</h2>
      <p class="lead">{lead}</p>
    </div>

    <div class="services-grid">
      {services.map((service) => (
        <article class="card card--hover service">
          <span class="icon-badge"><Icon name={service.icon} /></span>
          <h3 class="h3">{service.title[locale]}</h3>
          <p>{service.description[locale]}</p>
          <span class="price">{service.price}</span>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .service h3 {
    margin-bottom: 12px;
  }

  .service p {
    color: var(--muted);
    font-size: 0.98rem;
  }

  .price {
    display: inline-block;
    margin-top: 20px;
    font-weight: 700;
    color: var(--primary);
    font-family: var(--font-head);
  }

  @media (max-width: 980px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 620px) {
    .services-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
