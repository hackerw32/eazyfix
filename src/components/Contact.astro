---
const { business, locale } = Astro.props;
---

<section id="contact" class="contact">
  <div class="container">
    <h2 class="section-title">
      {locale === 'el' ? 'Επικοινωνία' : 'Contact Us'}
    </h2>
    <div class="contact-grid">
      <div class="contact-info">
        <div class="contact-item">
          <span class="contact-icon">📞</span>
          <div>
            <h4>{locale === 'el' ? 'Τηλέφωνο' : 'Phone'}</h4>
            <a href={`tel:${business.phone}`}>{business.phone}</a>
          </div>
        </div>
        <div class="contact-item">
          <span class="contact-icon">💬</span>
          <div>
            <h4>WhatsApp</h4>
            <a href={`https://wa.me/${business.whatsapp}`} target="_blank" rel="noopener">{business.whatsapp}</a>
          </div>
        </div>
        <div class="contact-item">
          <span class="contact-icon">✉️</span>
          <div>
            <h4>Email</h4>
            <a href={`mailto:${business.email}`}>{business.email}</a>
          </div>
        </div>
        <div class="contact-item">
          <span class="contact-icon">📍</span>
          <div>
            <h4>{locale === 'el' ? 'Περιοχή' : 'Area'}</h4>
            <p>{business.address[locale]}</p>
          </div>
        </div>
        <div class="contact-item">
          <span class="contact-icon">🕐</span>
          <div>
            <h4>{locale === 'el' ? 'Ώρες' : 'Hours'}</h4>
            <p>{business.hours[locale]}</p>
          </div>
        </div>
      </div>
      <form class="contact-form" id="contactForm" data-whatsapp={business.whatsapp} data-locale={locale}>
        <div class="form-group">
          <label for="name">{locale === 'el' ? 'Όνομα' : 'Name'}</label>
          <input type="text" id="name" name="name" required />
        </div>
        <div class="form-group">
          <label for="phone">{locale === 'el' ? 'Τηλέφωνο' : 'Phone'}</label>
          <input type="tel" id="phone" name="phone" required />
        </div>
        <div class="form-group">
          <label for="service">{locale === 'el' ? 'Υπηρεσία' : 'Service'}</label>
          <select id="service" name="service" required>
            <option value="">{locale === 'el' ? 'Επιλέξτε...' : 'Select...'}</option>
            <option value="computer">{locale === 'el' ? 'Επισκευή Υπολογιστών' : 'Computer Repair'}</option>
            <option value="laptop">{locale === 'el' ? 'Επισκευή Λάπτοπ' : 'Laptop Repair'}</option>
            <option value="mobile">{locale === 'el' ? 'Επισκευή Κινητών' : 'Mobile Repair'}</option>
            <option value="virus">{locale === 'el' ? 'Καθαρισμός Ιών' : 'Virus Removal'}</option>
            <option value="data">{locale === 'el' ? 'Ανάκτηση Δεδομένων' : 'Data Recovery'}</option>
            <option value="other">{locale === 'el' ? 'Άλλο' : 'Other'}</option>
          </select>
        </div>
        <div class="form-group">
          <label for="message">{locale === 'el' ? 'Μήνυμα' : 'Message'}</label>
          <textarea id="message" name="message" rows="4" required></textarea>
        </div>
        <button type="submit" class="submit-btn">
          {locale === 'el' ? 'Αποστολή' : 'Send Message'}
        </button>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contactForm');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    const locale = form.dataset.locale === 'en' ? 'en' : 'el';
    const whatsapp = form.dataset.whatsapp || '';
    const name = formData.get('name');
    const phone = formData.get('phone');
    const service = String(formData.get('service') ?? '');
    const message = formData.get('message');

    const serviceNames = locale === 'en'
      ? { computer: 'Computer Repair', laptop: 'Laptop Repair', mobile: 'Mobile Repair', virus: 'Virus Removal', data: 'Data Recovery', other: 'Other' }
      : { computer: 'Επισκευή Υπολογιστών', laptop: 'Επισκευή Λάπτοπ', mobile: 'Επισκευή Κινητών', virus: 'Καθαρισμός Ιών', data: 'Ανάκτηση Δεδομένων', other: 'Άλλο' };

    const header = locale === 'en' ? 'New Repair Request' : 'Νέο Αίτημα Επισκευής';
    const labels = locale === 'en'
      ? { name: 'Name', phone: 'Phone', service: 'Service', message: 'Message' }
      : { name: 'Όνομα', phone: 'Τηλέφωνο', service: 'Υπηρεσία', message: 'Μήνυμα' };

    const text = `${header}%0A%0A${labels.name}: ${name}%0A${labels.phone}: ${phone}%0A${labels.service}: ${serviceNames[service]}%0A${labels.message}: ${message}`;
    window.open(`https://wa.me/${whatsapp}?text=${text}`, '_blank');
  });
</script>

<style>
  .contact {
    padding: 80px 0;
    background: #f8f9ff;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 50px;
    max-width: 1000px;
    margin: 0 auto;
  }

  .contact-info {
    display: flex;
    flex-direction: column;
    gap: 25px;
  }

  .contact-item {
    display: flex;
    align-items: flex-start;
    gap: 15px;
  }

  .contact-icon {
    font-size: 1.5rem;
  }

  .contact-item h4 {
    color: #1a1a2e;
    margin-bottom: 5px;
  }

  .contact-item a {
    color: #6c63ff;
    text-decoration: none;
    font-weight: 500;
  }

  .contact-item a:hover {
    text-decoration: underline;
  }

  .contact-item p {
    color: #4a4a68;
  }

  .contact-form {
    background: white;
    padding: 30px;
    border-radius: 16px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
  }

  .form-group {
    margin-bottom: 20px;
  }

  .form-group label {
    display: block;
    margin-bottom: 8px;
    font-weight: 500;
    color: #1a1a2e;
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    width: 100%;
    padding: 12px 15px;
    border: 2px solid #e0e0e0;
    border-radius: 8px;
    font-size: 1rem;
    transition: border-color 0.3s;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: #6c63ff;
  }

  .submit-btn {
    width: 100%;
    padding: 15px;
    background: #6c63ff;
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 1.1rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.3s;
  }

  .submit-btn:hover {
    background: #5a52d5;
  }

  @media (max-width: 768px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
