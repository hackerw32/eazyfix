---
import Icon from './Icon.astro';

interface Props {
  business: {
    name: string;
    phone: string;
    email: string;
    whatsapp: string;
    address: Record<string, string>;
    hours: Record<string, string>;
  };
  contact: { title: Record<string, string>; subtitle: Record<string, string> };
  locale: 'el' | 'en';
}

const { business, contact, locale } = Astro.props;

const labels =
  locale === 'en'
    ? {
        name: 'Name',
        phone: 'Phone',
        service: 'Service',
        message: 'Message',
        submit: 'Send message',
        choose: 'Select...',
        other: 'Other',
        whatsapp: 'WhatsApp',
        serviceOptions: ['Computer repair', 'Laptop repair', 'Mobile repair', 'Virus removal', 'Data recovery', 'Website design', 'Other'],
      }
    : {
        name: 'Όνομα',
        phone: 'Τηλέφωνο',
        service: 'Υπηρεσία',
        message: 'Μήνυμα',
        submit: 'Αποστολή',
        choose: 'Επιλέξτε...',
        other: 'Άλλο',
        whatsapp: 'WhatsApp',
        serviceOptions: ['Επισκευή υπολογιστή', 'Επισκευή λάπτοπ', 'Επισκευή κινητού', 'Καθαρισμός ιών', 'Ανάκτηση δεδομένων', 'Κατασκευή ιστοσελίδας', 'Άλλο'],
      };
---

<section id="contact" class="section">
  <div class="container contact-grid">
    <div class="contact-info">
      <div class="section-head" style="margin-bottom:32px">
        <h2 class="h2">{contact.title[locale]}</h2>
        <p class="lead">{contact.subtitle[locale]}</p>
      </div>

      <ul class="info-list">
        <li>
          <span class="info-icon"><Icon name="phone" size={20} /></span>
          <div>
            <small>{locale === 'en' ? 'Phone' : 'Τηλέφωνο'}</small>
            <a href={`tel:${business.phone}`}>{business.phone}</a>
          </div>
        </li>
        <li>
          <span class="info-icon"><Icon name="mail" size={20} /></span>
          <div>
            <small>Email</small>
            <a href={`mailto:${business.email}`}>{business.email}</a>
          </div>
        </li>
        <li>
          <span class="info-icon"><Icon name="map-pin" size={20} /></span>
          <div>
            <small>{locale === 'en' ? 'Area' : 'Περιοχή'}</small>
            <span>{business.address[locale]}</span>
          </div>
        </li>
        <li>
          <span class="info-icon"><Icon name="clock" size={20} /></span>
          <div>
            <small>{locale === 'en' ? 'Hours' : 'Ώρες'}</small>
            <span>{business.hours[locale]}</span>
          </div>
        </li>
      </ul>
    </div>

    <form class="contact-form" id="contactForm" data-whatsapp={business.whatsapp} data-locale={locale}>
      <div class="field">
        <label for="name">{labels.name}</label>
        <input type="text" id="name" name="name" required />
      </div>
      <div class="field">
        <label for="phone">{labels.phone}</label>
        <input type="tel" id="phone" name="phone" required />
      </div>
      <div class="field">
        <label for="service">{labels.service}</label>
        <select id="service" name="service" required>
          <option value="">{labels.choose}</option>
          <option value="computer">{labels.serviceOptions[0]}</option>
          <option value="laptop">{labels.serviceOptions[1]}</option>
          <option value="mobile">{labels.serviceOptions[2]}</option>
          <option value="virus">{labels.serviceOptions[3]}</option>
          <option value="data">{labels.serviceOptions[4]}</option>
          <option value="website">{labels.serviceOptions[5]}</option>
          <option value="other">{labels.serviceOptions[6]}</option>
        </select>
      </div>
      <div class="field">
        <label for="message">{labels.message}</label>
        <textarea id="message" name="message" rows="4" required></textarea>
      </div>
      <button type="submit" class="btn btn--primary btn--block">
        {labels.submit}
        <Icon name="arrow-right" size={18} />
      </button>
    </form>
  </div>
</section>

<script>
  const form = document.getElementById('contactForm');
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const locale = form.dataset.locale === 'en' ? 'en' : 'el';
    const whatsapp = form.dataset.whatsapp || '';

    const serviceNames = {
      computer: locale === 'en' ? 'Computer repair' : 'Επισκευή υπολογιστή',
      laptop: locale === 'en' ? 'Laptop repair' : 'Επισκευή λάπτοπ',
      mobile: locale === 'en' ? 'Mobile repair' : 'Επισκευή κινητού',
      virus: locale === 'en' ? 'Virus removal' : 'Καθαρισμός ιών',
      data: locale === 'en' ? 'Data recovery' : 'Ανάκτηση δεδομένων',
      website: locale === 'en' ? 'Website design' : 'Κατασκευή ιστοσελίδας',
      other: locale === 'en' ? 'Other' : 'Άλλο',
    };

    const header = locale === 'en' ? 'New request' : 'Νέο αίτημα';
    const labels =
      locale === 'en'
        ? { name: 'Name', phone: 'Phone', service: 'Service', message: 'Message' }
        : { name: 'Όνομα', phone: 'Τηλέφωνο', service: 'Υπηρεσία', message: 'Μήνυμα' };

    const service = String(data.get('service') ?? '');
    const text = `${header}%0A%0A${labels.name}: ${data.get('name')}%0A${labels.phone}: ${data.get('phone')}%0A${labels.service}: ${serviceNames[service] ?? service}%0A${labels.message}: ${data.get('message')}`;
    window.open(`https://wa.me/${whatsapp}?text=${text}`, '_blank');
  });
</script>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: start;
  }

  .info-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 22px;
  }

  .info-list li {
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }

  .info-icon {
    width: 46px;
    height: 46px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    background: var(--primary-50);
    color: var(--primary);
    flex-shrink: 0;
  }

  .info-list small {
    display: block;
    color: var(--muted);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 2px;
  }

  .info-list a,
  .info-list span {
    font-weight: 600;
  }

  .info-list a:hover {
    color: var(--primary);
  }

  .contact-form {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 34px;
    box-shadow: var(--shadow-md);
  }

  .field {
    margin-bottom: 18px;
  }

  .field label {
    display: block;
    font-weight: 600;
    font-size: 0.9rem;
    margin-bottom: 7px;
  }

  .field input,
  .field select,
  .field textarea {
    width: 100%;
    padding: 13px 15px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    font-size: 0.97rem;
    font-family: inherit;
    background: #fff;
    transition: border-color 0.18s ease, box-shadow 0.18s ease;
  }

  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 4px var(--primary-50);
  }

  .field textarea {
    resize: vertical;
  }

  @media (max-width: 860px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
</style>
