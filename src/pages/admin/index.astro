---
import '../../styles/admin.css';
import { COOKIE_NAME, isValidSession } from '../../lib/auth';

if (!(await isValidSession(Astro.cookies.get(COOKIE_NAME)?.value))) {
  return Astro.redirect('/admin/login');
}
---

<!DOCTYPE html>
<html lang="el">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>EazyFix Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sora:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="admin-top">
      <div class="admin-top-inner">
        <span class="admin-brand">
          <span class="mark">
            <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" />
            </svg>
          </span>
          <span>EazyFix<small>Admin</small></span>
        </span>

        <nav class="admin-tabs" id="adminTabs">
          <button type="button" data-tab="business" class="active">Επιχείρηση</button>
          <button type="button" data-tab="projects">Projects</button>
        </nav>

        <div class="admin-top-actions">
          <a href="/" target="_blank" rel="noopener">Προβολή site</a>
          <span id="save-status"></span>
          <button id="save-btn" class="abtn abtn--primary">Αποθήκευση</button>
          <form method="POST" action="/api/admin/logout">
            <button type="submit" class="abtn abtn--ghost">Αποσύνδεση</button>
          </form>
        </div>
      </div>
    </header>

    <main class="admin-main">
      <div id="admin-content"><div class="loading">Φόρτωση...</div></div>
    </main>

    <script>
      import '../../scripts/admin.js';
    </script>
  </body>
</html>
