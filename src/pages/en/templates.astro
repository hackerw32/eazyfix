---
import Layout from '../../layouts/Layout.astro';
import TemplatesGallery from '../../components/TemplatesGallery.astro';
import { getBusiness } from '../../lib/content';

const locale = 'en';
const business = await getBusiness();
---

<Layout
  title="Website Templates - EazyFix"
  description="Ready-made website templates for every profession. Browse fully functional demos."
  locale={locale}
  business={business}
>
  <TemplatesGallery locale={locale} />
</Layout>
